* {
  box-sizing: border-box;
}

html, body {
  margin: 0;
  min-height: 100%;
  font-family: Arial, Helvetica, sans-serif;
  background: #070b14;
  color: #edf2ff;
}

body {
  min-height: 100vh;
}

button, input, textarea {
  font: inherit;
}

button {
  cursor: pointer;
}

.scion-shell {
  display: grid;
  grid-template-columns: 260px minmax(0, 1.4fr) 320px;
  min-height: 100vh;
  background:
    radial-gradient(circle at top, rgba(59, 130, 246, 0.25), transparent 28%),
    linear-gradient(135deg, #050b14, #0d1625 30%, #0a1220 100%);
}

.sidebar,
.memory-panel {
  background: rgba(9, 15, 24, 0.82);
  border-right: 1px solid rgba(148, 163, 184, 0.18);
  padding: 20px 16px;
}

.memory-panel {
  border-right: none;
  border-left: 1px solid rgba(148, 163, 184, 0.18);
}

.brand-block {
  margin-bottom: 18px;
}

.brand-mark {
  font-size: 1.8rem;
  font-weight: 700;
  letter-spacing: 0.14em;
  color: #9ae6ff;
}

.brand-block p,
.eyebrow,
.panel-card p,
.document-item p,
.message-role,
.empty-state p {
  color: #b7c5d9;
}

.primary-button,
.secondary-button {
  border: none;
  border-radius: 10px;
  padding: 0.8rem 1rem;
  transition: transform 0.15s ease;
}

.primary-button {
  background: linear-gradient(135deg, #38bdf8, #7c3aed);
  color: white;
  width: 100%;
  font-weight: 700;
}

.secondary-button {
  background: rgba(148, 163, 184, 0.12);
  color: white;
  border: 1px solid rgba(148, 163, 184, 0.2);
  width: 100%;
}

.primary-button:hover,
.secondary-button:hover {
  transform: translateY(-1px);
}

.session-list {
  display: flex;
  flex-direction: column;
  gap: 10px;
  margin-top: 18px;
}

.session-item {
  padding: 12px;
  border-radius: 12px;
  border: 1px solid rgba(148, 163, 184, 0.18);
  background: rgba(15, 23, 42, 0.8);
  color: #edf2ff;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  text-align: left;
}

.session-item.active {
  background: rgba(56, 189, 248, 0.12);
  border-color: rgba(56, 189, 248, 0.5);
}

.content {
  padding: 22px 18px;
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.topbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16px;
  padding-bottom: 10px;
  border-bottom: 1px solid rgba(148, 163, 184, 0.14);
}

.topbar h1 {
  margin: 0;
  font-size: clamp(1.7rem, 3vw, 2.5rem);
}

.eyebrow {
  text-transform: uppercase;
  letter-spacing: 0.12em;
  font-size: 0.72rem;
  margin: 0 0 6px;
}

.status-pill {
  background: rgba(16, 185, 129, 0.15);
  color: #a7f3d0;
  padding: 8px 12px;
  border-radius: 999px;
  border: 1px solid rgba(16, 185, 129, 0.35);
}

.chat-panel {
  flex: 1;
  overflow: auto;
  padding: 14px;
  background: rgba(15, 23, 42, 0.44);
  border: 1px solid rgba(148, 163, 184, 0.12);
  border-radius: 16px;
  display: flex;
  flex-direction: column;
  gap: 14px;
}

.message-row {
  display: flex;
}

.message-row.user {
  justify-content: flex-end;
}

.message-bubble {
  max-width: min(80%, 700px);
  border-radius: 16px;
  padding: 12px 14px;
  border: 1px solid rgba(59, 130, 246, 0.22);
  background: rgba(15, 118, 110, 0.12);
}

.message-row.user .message-bubble {
  background: rgba(59, 130, 246, 0.16);
}

.message-role {
  display: inline-block;
  font-size: 0.72rem;
  text-transform: uppercase;
  margin-bottom: 4px;
  letter-spacing: 0.08em;
}

.message-bubble p {
  margin: 0;
  line-height: 1.6;
  white-space: pre-wrap;
}

.empty-state {
  display: grid;
  place-items: center;
  min-height: 220px;
  text-align: center;
  color: white;
}

.empty-state h2 {
  margin: 0 0 10px;
  font-size: clamp(1.2rem, 2vw, 2rem);
}

.composer {
  padding-top: 16px;
}

.composer textarea,
.panel-card input,
.panel-card textarea {
  width: 100%;
  background: rgba(15, 23, 42, 0.75);
  border: 1px solid rgba(148, 163, 184, 0.18);
  border-radius: 12px;
  color: #edf2ff;
  padding: 12px 14px;
}

.composer textarea {
  resize: vertical;
  min-height: 120px;
}

.composer-actions {
  display: flex;
  justify-content: flex-end;
  margin-top: 12px;
}

.memory-panel {
  display: flex;
  flex-direction: column;
  gap: 18px;
}

.panel-card {
  background: rgba(15, 23, 42, 0.7);
  border: 1px solid rgba(148, 163, 184, 0.12);
  border-radius: 16px;
  padding: 16px;
}

.panel-card h3 {
  margin: 0 0 12px;
}

.document-item {
  padding: 10px 0;
  border-top: 1px solid rgba(148, 163, 184, 0.12);
}

.document-item:first-of-type {
  border-top: none;
}

.document-item strong {
  display: block;
  margin-bottom: 4px;
}

.panel-card input,
.panel-card textarea {
  margin-bottom: 10px;
}

@media (max-width: 1100px) {
  .scion-shell {
    grid-template-columns: 1fr;
  }

  .sidebar,
  .memory-panel {
    border: none;
  }
}
